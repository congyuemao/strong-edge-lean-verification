+theorem high22_shared_root_types_card_le_four
+    (hΔ : ∀ x, G.degree x ≤ 4) (Q : Finset G.edgeSet)
+    (h22 : ∀ e ∈ Q, 22 ≤ (conflictGraph G).degree e)
