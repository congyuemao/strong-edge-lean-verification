+  (ha : a ∈ StrongEdge.rootLabels G Q r) :
+  ∑ x ∈ (G.neighborFinset a).erase r, ((StrongEdge.rootType G r x).erase a).card ≤ 2
+StrongEdge.high22_clique_card_le_seventeen_of_root_four.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
