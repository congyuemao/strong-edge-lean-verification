+  have hcb := card_erase_add_one (mem_erase.mpr ⟨hab.symm, (G.mem_neighborFinset p b).mpr hpb'.2⟩)
+  have hd := hΔ p
+  simp only [SimpleGraph.card_neighborFinset_eq_degree] at hca
