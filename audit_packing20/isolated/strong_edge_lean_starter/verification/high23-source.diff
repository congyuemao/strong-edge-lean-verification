+  have hcx := card_erase_add_one ((G.mem_neighborFinset x a).mpr hax.symm)
+  have hda := hΔ a
+  have hdx := hΔ x
+  simp only [SimpleGraph.card_neighborFinset_eq_degree] at hca hcx
+  omega
