+  have hc := endpointNeighbourCover_card_le_six G huv hΔ
+  have hd := conflict_degree_le_incidence_sum G e he
+  have hs := sum_le_sum (s := endpointNeighbourCover G u v) (fun w _ => hΔ w)
+  simp only [sum_const, smul_eq_mul] at hs
+  omega
