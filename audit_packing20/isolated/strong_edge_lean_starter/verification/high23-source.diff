+      have hyb : y ≠ b := fun h => hry (h.symm ▸ hpb'.1)
+      exact ⟨y, mem_erase.mpr ⟨hyb, mem_erase.mpr ⟨hya, (G.mem_neighborFinset p y).mpr hpy⟩⟩, hy⟩
