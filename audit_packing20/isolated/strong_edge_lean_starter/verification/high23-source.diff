+
+theorem high23_outer_edges_card_le_two
+    (hΔ : ∀ x, G.degree x ≤ 4) (Q : Finset G.edgeSet)
+    (hQ : (conflictGraph G).IsClique (Q : Set G.edgeSet))
+    (h23 : ∀ e ∈ Q, 23 ≤ (conflictGraph G).degree e)
