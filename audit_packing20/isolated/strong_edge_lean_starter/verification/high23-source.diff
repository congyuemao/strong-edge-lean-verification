+omit [DecidableRel (conflictGraph G).Adj] in
+theorem singleRootEdges_card_le_singleTips (Q : Finset G.edgeSet) (r : V) :
+    (singleRootEdges G Q r).card ≤ (singleTips G Q r).card := by
+  classical
