+  apply mem_filter.mpr
+  refine ⟨mem_univ _, (mem_filter.mp hx).2.1, ?_, ?_⟩
+  · rw [← heq, hc]
+  · intro a ha
+    obtain ⟨haN, e, he, hea⟩ := mem_filter.mp (heq.symm ▸ ha)
+    exact mem_filter.mpr ⟨haN, e, (mem_filter.mp (mem_filter.mp he).1).1, hea⟩
