+theorem high21_multipleTips_eq_of_type_four
+    (hΔ : ∀ x, G.degree x ≤ 4) (Q : Finset G.edgeSet)
+    (h21 : ∀ e ∈ Q, 21 ≤ (conflictGraph G).degree e)
