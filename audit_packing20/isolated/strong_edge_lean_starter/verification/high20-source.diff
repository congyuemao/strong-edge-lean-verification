+theorem root_card_le_ten_of_label_selected_degree_le_two
+    (hΔ : ∀ x, G.degree x ≤ 4) (Q : Finset G.edgeSet) (r : V)
+    (hR : (rootLabels G Q r).card = 4) {a : V} (ha : G.Adj r a)
