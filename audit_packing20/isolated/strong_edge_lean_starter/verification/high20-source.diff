+  have hc := card_le_card hs
+  have he := card_erase_add_one ((G.mem_neighborFinset a x).mpr hax)
+  rw [rootLabels_card] at hc
+  simp only [SimpleGraph.card_neighborFinset_eq_degree] at he
+  omega
