StrongEdge.packing20_of_thresholds.{u_1} {W : Type u_1} [Fintype W] [DecidableEq W] (H : SimpleGraph W)
  [DecidableRel H.Adj] (ht : StrongEdge.CliqueThresholds20 H) :
  ∃ M, H.IsMaximumIndepSet M ∧ Fintype.card W ≤ 20 * M.card
StrongEdge.induced_matching_packing20_of_thresholds.{u_2} {V : Type u_2} (G : SimpleGraph V) [Fintype ↑G.edgeSet]
  [DecidableEq ↑G.edgeSet] [DecidableRel (StrongEdge.conflictGraph G).Adj]
  (ht : StrongEdge.CliqueThresholds20 (StrongEdge.conflictGraph G)) (F : Finset ↑G.edgeSet) :
  ∃ M ⊆ F, StrongEdge.IsInducedMatching G ↑M ∧ F.card ≤ 20 * M.card
StrongEdge.conflict_degree_le_24.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] (G : SimpleGraph V)
  [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj] (hΔ : ∀ (x : V), G.degree x ≤ 4)
  (e : ↑G.edgeSet) : (StrongEdge.conflictGraph G).degree e ≤ 24
StrongEdge.induced_matching_packing20_of_minimal_clique_bounds.{u_2} {V : Type u_2} [Fintype V] [DecidableEq V]
  (G : SimpleGraph V) [DecidableRel G.Adj] [DecidableRel (StrongEdge.conflictGraph G).Adj]
  (hΔ : ∀ (x : V), G.degree x ≤ 4) (hb : StrongEdge.MinimalCliqueBounds20 (StrongEdge.conflictGraph G))
  (F : Finset ↑G.edgeSet) : ∃ M ⊆ F, StrongEdge.IsInducedMatching G ↑M ∧ F.card ≤ 20 * M.card
